{
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": "build/client",
  "bunVersion": "1.x",
  "functions": {
    "api/server.js": {
      "runtime": "bun"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/server" }
  ]
}
